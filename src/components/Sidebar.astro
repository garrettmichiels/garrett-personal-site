---
const navLinks = [
  { label: 'Home', href: '/#home' },
  { label: 'Experience', href: '/#experience' },
  { label: 'Education', href: '/#education' },
  { label: 'Writing', href: '/writing' },
];

const socialLinks = [
  { label: 'GitHub', href: 'https://github.com/garrettmichiels' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/garrett-michiels/' },
  { label: 'Email', href: 'mailto:garrett.michiels@gmail.com' },
];

const resourceLinks = [
  { label: 'Resume', href: '/Garrett-Michiels-resume.pdf' },
];
---

<nav class="sidebar" aria-label="Main navigation">
  <div class="sidebar-inner">
    <a href="/" class="nav-brand" id="nav-brand" aria-label="Home">
      <span class="brand-bracket">&lt;</span><span class="brand-initials">GM</span><span class="brand-bracket">&gt;</span>
    </a>

    <div class="nav-group">
      {navLinks.map((link) => (
        <a href={link.href} class="nav-link nav-primary">{link.label}</a>
      ))}
    </div>

    <div class="nav-group">
      {socialLinks.map((link) => (
        <a href={link.href} target="_blank" rel="noopener noreferrer" class="nav-link nav-secondary">{link.label}</a>
      ))}
    </div>

    <div class="nav-group">
      {resourceLinks.map((link) => (
        <a href={link.href} target="_blank" rel="noopener noreferrer" class="nav-link nav-secondary">{link.label}</a>
      ))}
    </div>
  </div>
</nav>

<style>
  .sidebar {
    position: fixed;
    left: 0;
    top: 0;
    height: 100vh;
    width: 148px;
    padding: var(--sp-8) var(--sp-5);
    display: flex;
    flex-direction: column;
    z-index: 10;
  }

  .sidebar-inner {
    display: flex;
    flex-direction: column;
    gap: var(--sp-6);
    padding-top: var(--sp-4);
  }

  .nav-group {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .nav-link {
    font-size: 0.84rem;
    line-height: 1.9;
    transition: color 0.2s ease;
    display: block;
    width: fit-content;
    position: relative;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 3px;
    width: 0;
    height: 1px;
    transition: width 0.3s ease;
  }

  .nav-link:hover::after {
    width: 100%;
  }

  .nav-primary {
    font-family: var(--font-heading);
    color: var(--ink);
    font-size: 0.9rem;
  }

  .nav-primary::after {
    background: var(--accent);
  }

  .nav-primary:hover {
    color: var(--accent);
  }

  .nav-secondary {
    font-family: var(--font-body);
    color: var(--text-2);
    font-size: 0.78rem;
  }

  .nav-secondary::after {
    background: var(--ink-2);
  }

  .nav-secondary:hover {
    color: var(--accent);
  }

  .nav-brand {
    font-family: var(--font-heading);
    font-size: 1.6rem;
    font-style: italic;
    color: var(--ink);
    letter-spacing: 0.01em;
    margin-bottom: var(--sp-1);
    display: block;
    transition: color 0.2s ease;
    white-space: nowrap;
    line-height: 1;
  }

  .brand-bracket {
    font-family: var(--font-mono);
    font-style: normal;
    font-size: 0.95rem;
    color: var(--accent);
    opacity: 0.7;
    margin: 0 2px;
    vertical-align: 0.12em;
  }

  .brand-initials {
    letter-spacing: 0.02em;
  }

  .nav-brand:hover {
    color: var(--accent);
  }

  .nav-brand:hover .brand-bracket {
    opacity: 1;
  }

  @media (max-width: 1100px) {
    .sidebar {
      display: none;
    }
  }
</style>
