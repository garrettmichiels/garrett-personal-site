---
const navLinks = [
  { label: 'Home', href: '#home' },
  { label: 'Work', href: '#work' },
  { label: 'Education', href: '#education' },
  // TODO: add { label: 'Postcards', href: '/postcards' } once that page exists
];

const socialLinks = [
  { label: 'GitHub', href: 'https://github.com/garrettmichiels' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/garrett-michiels/' },
  { label: 'Email', href: 'mailto:garrett.michiels@gmail.com' },
];

const resourceLinks = [
  { label: 'Resume', href: '/Garrett-Michiels-resume.pdf' },
];
---

<nav class="sidebar" aria-label="Main navigation">
  <a href="/" class="brand" aria-label="Home">
    <span class="bracket" aria-hidden="true">&lt;</span> <em>GM</em> <span class="bracket" aria-hidden="true">&gt;</span>
  </a>

  <div class="group primary">
    {navLinks.map((link) => (
      <a href={link.href} class="link">{link.label}</a>
    ))}
  </div>

  <div class="group secondary">
    {socialLinks.map((link) => (
      <a href={link.href} target="_blank" rel="noopener noreferrer" class="link">{link.label}</a>
    ))}
  </div>

  <div class="group secondary">
    {resourceLinks.map((link) => (
      <a href={link.href} target="_blank" rel="noopener noreferrer" class="link">{link.label}</a>
    ))}
  </div>
</nav>

<style>
  .sidebar {
    position: fixed;
    left: 0;
    top: 0;
    width: 148px;
    height: 100vh;
    padding: 44px 0 0 26px;
    display: flex;
    flex-direction: column;
    gap: 30px;
    z-index: 2;
  }

  .brand {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    line-height: 1;
    color: var(--ink);
    white-space: nowrap;
  }

  .bracket {
    color: var(--bracket);
  }

  .group {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .primary {
    gap: 10px;
    font-family: var(--font-heading);
    font-size: 1.05rem;
  }

  .primary .link {
    color: var(--ink-lead);
  }

  .secondary {
    gap: 9px;
    font-size: 0.82rem;
  }

  .secondary .link {
    color: var(--ink-link);
  }

  .link {
    position: relative;
    transition: color 0.2s ease;
  }

  .link:hover {
    color: var(--ink);
  }

  .link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -1px;
    width: 0;
    height: 1px;
    background: var(--accent);
    transition: width 0.3s ease;
  }

  .link:hover::after {
    width: 100%;
  }

  @media (max-width: 1099px) {
    .sidebar {
      display: none;
    }
  }

  @media print {
    .sidebar {
      display: none;
    }
  }
</style>
