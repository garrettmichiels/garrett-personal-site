---
const navLinks = [
  { label: 'Home', href: '#home' },
  { label: 'Experience', href: '#experience' },
  { label: 'Education', href: '#education' },
];

const socialLinks = [
  { label: 'GitHub', href: 'https://github.com/garrettmichiels' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/garrett-michiels/' },
  { label: 'Email', href: 'mailto:garrett.michiels@gmail.com' },
];

const resourceLinks = [
  { label: 'Resume', href: '/Garrett-Michiels-resume.pdf' },
];
---

<nav class="sidebar" aria-label="Main navigation">
  <div class="sidebar-inner">
    <div class="nav-group">
      {navLinks.map((link) => (
        <a href={link.href} class="nav-link nav-primary">{link.label}</a>
      ))}
    </div>

    <div class="nav-group">
      {socialLinks.map((link) => (
        <a href={link.href} target="_blank" rel="noopener noreferrer" class="nav-link nav-secondary">{link.label}</a>
      ))}
    </div>

    <div class="nav-group">
      {resourceLinks.map((link) => (
        <a href={link.href} target="_blank" rel="noopener noreferrer" class="nav-link nav-secondary">{link.label}</a>
      ))}
    </div>
  </div>
</nav>

<style>
  .sidebar {
    position: fixed;
    left: 0;
    top: 0;
    height: 100vh;
    width: 140px;
    padding: var(--sp-8) var(--sp-5);
    display: flex;
    flex-direction: column;
    justify-content: center;
    z-index: 10;
  }

  .sidebar-inner {
    display: flex;
    flex-direction: column;
    gap: var(--sp-6);
  }

  .nav-group {
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
  }

  .nav-link {
    font-family: var(--font-heading);
    font-size: 0.88rem;
    line-height: 1.9;
    transition: color 0.25s ease;
    display: block;
    width: fit-content;
    position: relative;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 2px;
    width: 0;
    height: 1px;
    transition: width 0.35s ease;
  }

  .nav-link:hover::after {
    width: 100%;
  }

  .nav-primary {
    color: var(--text-1);
    font-weight: 600;
  }

  .nav-primary::after {
    background: var(--accent-sand);
  }

  .nav-primary:hover {
    color: var(--accent-sand);
  }

  .nav-secondary {
    color: var(--text-4);
    font-size: 0.82rem;
  }

  .nav-secondary::after {
    background: var(--text-3);
  }

  .nav-secondary:hover {
    color: var(--text-2);
  }

  @media (max-width: 1100px) {
    .sidebar {
      display: none;
    }
  }
</style>
