---
import type { ImageMetadata } from 'astro';
import SectionLabel from './SectionLabel.astro';
import EntryRow from './EntryRow.astro';
import Tag from './Tag.astro';
import data from '../data/experience.json';

const logoModules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/images/*.{jpg,jpeg,png,webp}',
  { eager: true }
);

const logos: Record<string, ImageMetadata> = Object.fromEntries(
  Object.entries(logoModules).map(([path, mod]) => [path.split('/').pop()!, mod.default])
);

// Add new companies here when adding roles to experience.json.
// Brand color for the open row's left edge. Missing entries fall back to var(--accent).
const accentMap: Record<string, string> = {
  'Clarasight': '#595DE5',
  'Wayfair':    '#6F229A',
  'BlackBerry': '#244277',
  'Wellframe':  '#2C556B',
};

const slug = (text: string) => text.toLowerCase().replace(/[^a-z0-9]+/g, '-');

/* Number counter animation — disabled for the postcard redesign.
   To re-enable: uncomment this function, the counter script in
   BaseLayout.astro, and the [data-counter] block in global.css, then swap
   `<span>{detail}</span>` below for `<span set:html={highlightNumbers(detail)} />`.

function highlightNumbers(text: string): string {
  // Strip tags from source text before injecting into set:html to prevent XSS
  // if this data source ever changes from a local file to an external feed.
  const safe = text.replace(/<[^>]*>/g, '');
  return safe.replace(/~?(\d+)(k\+|%)/gi, (match, num, unit) => {
    const prefix = match.startsWith('~') ? '~' : '';
    const suffix = unit.toLowerCase();
    return `${prefix}<span data-counter="${num}" data-suffix="${suffix}">${num}${suffix}</span>`;
  });
}
*/
---

<section id="work" class="work">
  <SectionLabel text="work" />

  <ul class="entry-list">
    {data.roles.map((role, i) => {
      const img = logos[role.logo];
      if (!img) throw new Error(`Work logo not found: "${role.logo}". Add the file to src/assets/images/`);
      return (
        <li>
          <EntryRow
            id={`work-${slug(role.company)}`}
            name={role.company}
            role={role.title}
            years={role.years}
            summary={role.summary}
            logo={img}
            accent={accentMap[role.company] ?? 'var(--accent)'}
            eager={i === 0}
          >
            <div class="meta-row">
              <span>{role.date}</span>
              <span class="dot"></span>
              <span>{role.location}</span>
            </div>
            <ul class="bullets">
              {role.details.map((detail, idx) => (
                <li>
                  <span class="idx">{String(idx + 1).padStart(2, '0')}</span>
                  <span>{detail}</span>
                </li>
              ))}
            </ul>
            <div class="chips">
              {role.skills.map((skill) => <Tag text={skill} />)}
            </div>
          </EntryRow>
        </li>
      );
    })}
  </ul>
</section>

<style>
  .work {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .bullets {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .bullets li {
    display: flex;
    gap: 14px;
    font-size: 0.95rem;
    line-height: 1.7;
  }

  /* Fixed right-aligned column so every bullet's text shares one left edge */
  .idx {
    flex: none;
    width: 18px;
    padding-top: 0.3em;
    text-align: right;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-variant-numeric: tabular-nums;
    color: var(--ink-meta);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
  }
</style>
