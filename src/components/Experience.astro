---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import SectionLabel from './SectionLabel.astro';
import Tag from './Tag.astro';
import CalloutBox from './CalloutBox.astro';
import CircuitLines from '../art/circuit-lines.astro';
import data from '../data/experience.json';

const logoModules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/images/*.{jpg,jpeg,png,webp}',
  { eager: true }
);

const logos: Record<string, ImageMetadata> = Object.fromEntries(
  Object.entries(logoModules).map(([path, mod]) => [path.split('/').pop()!, mod.default])
);

/** Wrap notable numbers in data-counter spans for the animation script. */
function highlightNumbers(text: string): string {
  // Strip tags from source text before injecting into set:html to prevent XSS
  // if this data source ever changes from a local file to an external feed.
  const safe = text.replace(/<[^>]*>/g, '');
  return safe.replace(/~?(\d+)(k\+|%)/gi, (match, num, unit) => {
    const prefix = match.startsWith('~') ? '~' : '';
    const suffix = unit.toLowerCase();
    return `${prefix}<span data-counter="${num}" data-suffix="${suffix}">${num}${suffix}</span>`;
  });
}

// Add new companies here when adding roles to experience.json.
// Missing entries fall back to var(--accent) — intentional, but cards will
// lose their brand color, so update this map when adding a new role.
const accentMap: Record<string, string> = {
  'Clarasight': '#595DE5',
  'Wayfair':    '#6F229A',
  'BlackBerry': '#244277',
  'Wellframe':  '#2C556B',
};
---

<section class="section">
  <CircuitLines />
  <SectionLabel text="Experience" accent="var(--accent)" />
  <h2>Where I've built things</h2>

  <div class="roles">
    {data.roles.map((role, i) => (
      <div class="role stagger-item" style={`--role-accent: ${accentMap[role.company] ?? 'var(--accent)'};`}>
        <div class="role-header">
          {(() => {
            const img = logos[role.logo];
            if (!img) throw new Error(`Experience logo not found: "${role.logo}" — add the file to src/assets/images/`);
            return <Image src={img} alt={`${role.company} logo`} width={88} height={88} class="role-logo" draggable="false" loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'auto'} />;
          })()}
          <div class="role-meta">
            <h3>{role.title}</h3>
            <span class="role-company">{role.company}</span>
            <span class="role-date">{role.date}</span>
          </div>
        </div>
        <ul class="role-details">
          {role.details.map((detail, idx) => (
            <li>
              <span class="bullet-num">{String(idx + 1).padStart(2, '0')}</span>
              <span class="bullet-text" set:html={highlightNumbers(detail)} />
            </li>
          ))}
        </ul>
        <div class="role-skills">
          {role.skills.map((skill) => (
            <Tag text={skill} accent={accentMap[role.company]} />
          ))}
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  h2 {
    margin-top: 6px;
    margin-bottom: var(--sp-8);
  }

  .roles {
    display: flex;
    flex-direction: column;
    gap: var(--sp-8);
  }

  .role {
    background: var(--bg-raised);
    border: 1px solid var(--border-medium);
    border-left: 3px solid var(--role-accent, var(--accent));
    border-radius: 0 var(--radius-lg) var(--radius-lg) 0;
    padding: var(--sp-6);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .role:hover {
    transform: translateX(2px);
    box-shadow: 0 4px 20px rgba(0,0,0,0.06);
  }

  .role-header {
    display: flex;
    align-items: flex-start;
    gap: var(--sp-4);
    margin-bottom: var(--sp-4);
  }

  .role-logo {
    width: 44px;
    height: 44px;
    border-radius: var(--radius);
    object-fit: cover;
    flex-shrink: 0;
  }

  .role-meta {
    flex: 1;
  }

  .role-meta h3 {
    margin-bottom: 2px;
    color: var(--ink);
  }

  .role-company {
    font-family: var(--font-body);
    font-size: 0.84rem;
    color: var(--text-3);
    display: block;
    margin-bottom: 2px;
  }

  .role-date {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.1em;
    color: var(--text-5);
    text-transform: uppercase;
  }

  .role-details {
    margin-bottom: var(--sp-4);
  }

  .role-details li {
    display: flex;
    gap: 10px;
    padding: 7px 0;
    border-bottom: 1px solid var(--border-ghost);
  }

  .role-details li:last-child {
    border-bottom: none;
  }

  .bullet-num {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    color: var(--role-accent, var(--accent));
    margin-top: 3px;
    flex-shrink: 0;
    opacity: 0.7;
  }

  .bullet-text {
    font-family: var(--font-body);
    font-size: 0.84rem;
    line-height: 1.65;
    color: var(--text-2);
  }

  .role-skills {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  @media (max-width: 768px) {
    .role {
      border-left-width: 2px;
      padding: var(--sp-5);
    }
  }
</style>
