---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import SectionLabel from './SectionLabel.astro';
import Tag from './Tag.astro';
import data from '../data/experience.json';

const logoModules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/images/*.{jpg,jpeg,png,webp}',
  { eager: true }
);

const logos: Record<string, ImageMetadata> = Object.fromEntries(
  Object.entries(logoModules).map(([path, mod]) => [path.split('/').pop()!, mod.default])
);

// Add new companies here when adding roles to experience.json.
// Brand color for the card's left edge. Missing entries fall back to var(--accent).
const accentMap: Record<string, string> = {
  'Clarasight': '#595DE5',
  'Wayfair':    '#6F229A',
  'BlackBerry': '#244277',
  'Wellframe':  '#2C556B',
};

/* Number counter animation — disabled for the postcard redesign.
   To re-enable: uncomment this function, the counter script in
   BaseLayout.astro, and the [data-counter] block in global.css, then swap
   `<span>{detail}</span>` below for `<span set:html={highlightNumbers(detail)} />`.

function highlightNumbers(text: string): string {
  // Strip tags from source text before injecting into set:html to prevent XSS
  // if this data source ever changes from a local file to an external feed.
  const safe = text.replace(/<[^>]*>/g, '');
  return safe.replace(/~?(\d+)(k\+|%)/gi, (match, num, unit) => {
    const prefix = match.startsWith('~') ? '~' : '';
    const suffix = unit.toLowerCase();
    return `${prefix}<span data-counter="${num}" data-suffix="${suffix}">${num}${suffix}</span>`;
  });
}
*/
---

<section id="experience" class="experience">
  <div class="heading">
    <SectionLabel text="experience" />
    <h2>Where I've built things</h2>
  </div>

  <div class="roles">
    {data.roles.map((role, i) => {
      const img = logos[role.logo];
      if (!img) throw new Error(`Experience logo not found: "${role.logo}". Add the file to src/assets/images/`);
      return (
        <article class="role stagger-item" style={`--role-accent: ${accentMap[role.company] ?? 'var(--accent)'};`}>
          <Image
            src={img}
            alt={`${role.company} logo`}
            width={96}
            height={96}
            class="logo"
            draggable="false"
            loading={i === 0 ? 'eager' : 'lazy'}
          />
          <div class="body">
            <div>
              <h3 class="company">{role.company}</h3>
              <p class="title">{role.title}</p>
              <div class="meta-row">
                <span>{role.date}</span>
                <span class="dot"></span>
                <span>{role.location}</span>
              </div>
            </div>
            <ul class="bullets">
              {role.details.map((detail, idx) => (
                <li>
                  <span class="idx">{String(idx + 1).padStart(2, '0')}</span>
                  <span>{detail}</span>
                </li>
              ))}
            </ul>
            <div class="chips">
              {role.skills.map((skill) => <Tag text={skill} />)}
            </div>
          </div>
        </article>
      );
    })}
  </div>
</section>

<style>
  .experience {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .heading {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  h2 {
    font-size: 1.9rem;
    line-height: 1.15;
  }

  .roles {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .role {
    display: flex;
    gap: 18px;
    background: var(--card);
    border: 1px solid var(--card-border);
    border-left: 3px solid var(--role-accent);
    padding: 24px 26px;
  }

  .logo {
    flex: none;
    width: 48px;
    height: 48px;
    border-radius: 10px;
    object-fit: contain;
    background: var(--mount);
    border: 1px solid var(--card-border);
  }

  .body {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .company {
    font-size: 1.6rem;
    line-height: 1.1;
  }

  .title {
    margin-top: 2px;
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 1.12rem;
    line-height: 1.3;
    color: var(--ink-lead);
  }

  .meta-row {
    margin-top: 8px;
  }

  .bullets {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .bullets li {
    display: flex;
    gap: 14px;
    font-size: 0.95rem;
    line-height: 1.7;
  }

  /* Fixed right-aligned column so every bullet's text shares one left edge */
  .idx {
    flex: none;
    width: 18px;
    padding-top: 0.3em;
    text-align: right;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-variant-numeric: tabular-nums;
    color: var(--ink-meta);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
  }

  @media (max-width: 640px) {
    .role {
      flex-direction: column;
      gap: 14px;
      padding: 18px 18px 20px;
    }
  }
</style>
