---
import SectionLabel from './SectionLabel.astro';

const facts = [
  { label: 'based', value: 'Boston, MA' },
  { label: 'school', value: 'Northeastern CS, 2024' },
  { label: 'else', value: 'screen-printed postcards' },
];
---

<section id="about" class="about">
  <SectionLabel text="about" />

  <!-- TODO(copy): placeholder prose sized to the final length (~60 words). Replace before shipping. -->
  <p class="lead">
    Placeholder body copy, sized to the real thing. Two to three sentences about how he works and what he cares
    about, ending somewhere that makes the next line worth opening. Roughly sixty words is the target.
  </p>

  <button class="toggle" id="about-toggle" aria-expanded="false" aria-controls="about-more">
    <svg width="13" height="13" viewBox="0 0 13 13" fill="none" aria-hidden="true">
      <path d="M2 4.5 L6.5 9 L11 4.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
    </svg>
    <span id="about-toggle-label">more about me</span>
  </button>

  <div class="more" id="about-more" hidden>
    <!-- TODO(copy): placeholder prose. Replace before shipping. -->
    <p>
      Expanded placeholder. Room for a longer run of copy here: how he got into the work, what he is reading or
      building outside it, why the postcards exist. Paragraphs stack, so this grows without redesign.
    </p>
    <dl class="facts">
      {facts.map((f) => (
        <div>
          <dt>{f.label}</dt>
          <dd>{f.value}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<script>
  const toggle = document.getElementById('about-toggle');
  const label = document.getElementById('about-toggle-label');
  const more = document.getElementById('about-more');

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') !== 'true';
    toggle.setAttribute('aria-expanded', String(open));
    if (label) label.textContent = open ? 'less' : 'more about me';
    if (more) more.hidden = !open;
  });
</script>

<style>
  .about {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .lead {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--ink-lead);
    text-wrap: pretty;
  }

  .toggle {
    align-self: flex-start;
    display: flex;
    align-items: center;
    gap: 11px;
    padding: 9px 14px 9px 11px;
    border: 1px solid var(--card-border);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--accent);
    transition: background-color 0.15s;
  }

  .toggle:hover {
    background: var(--hover-fill);
  }

  .toggle svg {
    flex: none;
    transition: transform 0.18s;
  }

  .toggle[aria-expanded="true"] svg {
    transform: rotate(180deg);
  }

  .more {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding-top: 18px;
    border-top: 1px dashed var(--card-border);
  }

  .more p {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--ink-body);
    text-wrap: pretty;
  }

  .facts {
    display: flex;
    flex-direction: column;
    gap: 7px;
    padding-top: 2px;
  }

  .facts div {
    display: flex;
    gap: 14px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--ink-meta);
  }

  .facts dt {
    flex: none;
    width: 74px;
  }
</style>
