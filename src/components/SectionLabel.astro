---
interface Props {
  text: string;
}

const { text } = Astro.props;
---

<div class="section-label">
  <span>{text}</span>
</div>

<style>
  .section-label {
    display: flex;
    align-items: center;
    gap: 14px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--accent);
    white-space: nowrap;
  }

  .section-label::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--rule);
  }
</style>
