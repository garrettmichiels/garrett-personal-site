---
interface Props {
  text: string;
  accent?: string;
}

const { text, accent } = Astro.props;
---

<div class="section-label-wrap">
  <span class="section-label" style={accent ? `color: ${accent}` : undefined}>
    {text}
  </span>
</div>

<style>
  .section-label-wrap {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 8px;
  }

  .section-label-wrap::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--border-medium);
  }

  .section-label {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 400;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-5);
    white-space: nowrap;
  }
</style>
