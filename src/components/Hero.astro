---
import { Image } from 'astro:assets';
import portrait from '../assets/images/garrett-portrait.jpeg';
---

<section id="home" class="hero">
  <div class="hero-row">
    <figure class="mount">
      <Image
        src={portrait}
        alt="Garrett Michiels"
        width={272}
        height={320}
        class="portrait"
        id="portrait"
        draggable="false"
        loading="eager"
        fetchpriority="high"
      />
      <figcaption>no. 001</figcaption>
    </figure>

    <div class="intro">
      <div class="eyebrow">
        <span class="role">software engineer</span>
        <span class="now">
          <span>currently</span>Clarasight<span class="dot"></span>Boston, MA
        </span>
      </div>
      <h1>Building high-impact systems at <em>scale.</em></h1>
      <p class="bio">
        Currently building the future of AI Corporate Travel at <strong>Clarasight</strong>:
        deploying ML models, product engineering, and more. Before that, I shipped conversational AI at Wayfair,
        microservices at BlackBerry, and Kubernetes automation at Wellframe. Northeastern University CS, class of 2024.
      </p>
    </div>
  </div>

  <div class="ctas">
    <a href="/Garrett-Michiels-resume.pdf" target="_blank" rel="noopener noreferrer" class="cta cta-primary">
      View Resume
    </a>
    <a href="https://www.linkedin.com/in/garrett-michiels/" target="_blank" rel="noopener noreferrer" class="cta cta-ghost">
      Connect
    </a>
  </div>
</section>

<script>
  import { defineSound } from '@web-kits/audio';

  const pop = defineSound({
    source: { type: 'sine', frequency: { start: 650, end: 180 } },
    envelope: { attack: 0, decay: 0.09 },
    gain: 0.28,
  });

  document.getElementById('portrait')?.addEventListener('click', () => pop());
</script>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    gap: 30px;
  }

  .hero-row {
    display: flex;
    align-items: flex-start;
    gap: 34px;
  }

  /* Print mount: paper resting on paper, not a floating card */
  .mount {
    flex: none;
    background: var(--mount);
    padding: 13px 13px 22px;
    box-shadow: 0 1px 0 var(--chip-border);
  }

  .portrait {
    display: block;
    width: 136px;
    height: 160px;
    object-fit: cover;
    background: var(--photo);
    cursor: pointer;
  }

  figcaption {
    margin-top: 9px;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.07em;
    color: var(--ink-meta);
  }

  .intro {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding-top: 4px;
  }

  .eyebrow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 20px;
    padding-bottom: 11px;
    border-bottom: 1px solid var(--card-border);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .role {
    color: var(--accent);
  }

  .now {
    display: flex;
    align-items: center;
    gap: 9px;
    letter-spacing: 0.07em;
    color: var(--ink-meta);
  }

  h1 {
    font-size: 2.4rem;
    line-height: 1.08;
    text-wrap: balance;
  }

  .bio {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--ink-body);
    text-wrap: pretty;
  }

  .bio strong {
    font-weight: 500;
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 11px;
  }

  .cta {
    padding: 10px 18px;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }

  .cta-primary {
    background: var(--cta);
    color: var(--cta-text);
  }

  .cta-primary:hover {
    background: var(--accent);
    color: var(--cta-text);
  }

  .cta-ghost {
    border: 1px solid var(--cta-outline);
    color: var(--ink-body);
  }

  .cta-ghost:hover {
    background: var(--hover-fill);
    color: var(--ink);
  }

  @media (max-width: 640px) {
    .hero-row {
      flex-direction: column;
      gap: 24px;
    }

    .eyebrow {
      flex-wrap: wrap;
      row-gap: 8px;
    }

    h1 {
      font-size: 2.1rem;
    }
  }
</style>
