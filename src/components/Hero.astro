---
import { Image } from 'astro:assets';
import SectionLabel from './SectionLabel.astro';
import MarginBlobs from '../art/margin-blobs.astro';
import portrait from '../assets/images/garrett-portrait.jpeg';
---

<section class="section hero-section fade-in">
  <MarginBlobs />
  <div class="hero-layout">
    <div class="hero-image-wrap">
      <!-- Blob clip path definition -->
      <svg width="0" height="0" aria-hidden="true">
        <defs>
          <clipPath id="blob-clip" clipPathUnits="objectBoundingBox">
            <path d="M0.45,0.02 C0.62,0.0 0.78,0.06 0.89,0.17 C0.98,0.28 1.01,0.44 0.98,0.6 C0.96,0.75 0.88,0.88 0.74,0.96 C0.6,1.02 0.42,1.01 0.28,0.95 C0.14,0.87 0.04,0.74 0.02,0.58 C-0.01,0.42 0.02,0.26 0.1,0.15 C0.19,0.05 0.32,0.03 0.45,0.02Z" />
          </clipPath>
        </defs>
      </svg>
      <!-- Blob outline behind image -->
      <svg class="blob-outline" viewBox="0 0 180 200" aria-hidden="true">
        <path
          d="M81,4 C112,0 140,12 160,34 C176,56 182,88 176,120 C173,150 158,176 133,192 C108,204 76,202 50,190 C25,174 7,148 4,116 C-2,84 4,52 18,30 C34,10 58,6 81,4Z"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          opacity="0.25"
          class="blob-stroke"
        />
      </svg>
      <Image
        src={portrait}
        alt="Garrett Michiels"
        width={360}
        height={400}
        class="hero-image"
        id="portrait"
        draggable="false"
        loading="eager"
        fetchpriority="high"
      />
    </div>
    <div class="hero-content">
      <SectionLabel text="Software Engineer" accent="var(--accent)" />
      <h1>Building high-impact<br />systems at <em>scale.</em></h1>
      <p class="hero-bio">
        I build the infrastructure behind conversational AI at <strong>Wayfair</strong> —
        routing LLM inputs, processing <span data-counter="400" data-suffix="k+">400k+</span> Kafka messages daily, and automating what used
        to take engineers <span data-counter="20" data-suffix=" min">20 min</span> by hand. Before that, I shipped microservices at
        BlackBerry and Kubernetes automation at Wellframe. Northeastern CS, class of 2024.
      </p>
      <div class="hero-ctas">
        <a href="/Garrett-Michiels-resume.pdf" target="_blank" rel="noopener noreferrer" class="cta-primary">
          View Resume
        </a>
        <a href="https://www.linkedin.com/in/garrett-michiels/" target="_blank" rel="noopener noreferrer" class="cta-ghost">
          Connect
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  import { defineSound } from '@web-kits/audio';

  const pop = defineSound({
    source: { type: 'sine', frequency: { start: 650, end: 180 } },
    envelope: { attack: 0, decay: 0.09 },
    gain: 0.28,
  });

  document.getElementById('portrait')?.addEventListener('click', () => pop());
</script>

<style>
  .hero-section {
    padding-top: var(--sp-12);
    padding-bottom: var(--sp-10);
  }

  .hero-layout {
    display: flex;
    align-items: flex-start;
    gap: var(--sp-10);
  }

  .hero-image-wrap {
    flex-shrink: 0;
    position: relative;
  }

  .blob-outline {
    position: absolute;
    top: -4px;
    left: -4px;
    width: 188px;
    height: 208px;
    pointer-events: none;
  }

  .hero-image {
    width: 180px;
    height: 200px;
    object-fit: cover;
    clip-path: url(#blob-clip);
    transition: transform 0.4s ease;
  }

  .hero-image-wrap:hover .hero-image {
    transform: scale(1.02);
  }

  #portrait {
    cursor: pointer;
  }

  .hero-content {
    flex: 1;
    min-width: 0;
  }

  h1 {
    margin-top: 8px;
    font-size: clamp(1.6rem, 3.5vw, 2.4rem);
  }

  h1 em {
    font-style: italic;
    color: var(--accent);
  }

  .blob-stroke {
    color: var(--accent);
  }

  .hero-bio {
    margin-top: var(--sp-4);
    max-width: 540px;
  }

  .hero-bio strong {
    color: var(--ink);
    font-weight: 600;
  }

  /* CTAs */
  .hero-ctas {
    display: flex;
    gap: var(--sp-3);
    margin-top: var(--sp-6);
    flex-wrap: wrap;
    align-items: center;
  }

  .cta-primary,
  .cta-ghost,
  .cta-mono {
    font-size: 0.75rem;
    padding: 9px 20px;
    border-radius: var(--radius);
    transition: all 0.18s ease;
    letter-spacing: 0.01em;
    display: inline-block;
  }

  .cta-primary {
    font-family: var(--font-body);
    font-weight: 500;
    background: var(--accent);
    color: var(--white);
    border: 1.5px solid var(--accent);
  }

  .cta-primary:hover {
    background: var(--accent-deep);
    border-color: var(--accent-deep);
    transform: translateY(-1px);
  }

  .cta-ghost {
    font-family: var(--font-body);
    font-weight: 500;
    background: transparent;
    color: var(--accent);
    border: 1.5px solid var(--accent-muted);
  }

  .cta-ghost:hover {
    background: var(--accent-soft);
    border-color: var(--accent);
    transform: translateY(-1px);
  }

  .cta-mono {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    background: var(--ink);
    color: var(--paper);
    border: 1.5px solid var(--ink);
  }

  .cta-mono:hover {
    background: var(--ink-2);
    border-color: var(--ink-2);
    transform: translateY(-1px);
  }

  @media (max-width: 768px) {
    .hero-section {
      padding-top: var(--sp-8);
    }

    .hero-layout {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: var(--sp-6);
    }

    .hero-image {
      width: 140px;
      height: 155px;
    }

    .blob-outline {
      width: 148px;
      height: 163px;
    }

    .hero-bio {
      max-width: none;
    }

    .hero-stack,
    .hero-ctas {
      justify-content: center;
    }
  }
</style>
