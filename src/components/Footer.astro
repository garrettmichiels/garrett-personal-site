---
import { Image } from 'astro:assets';
import boston from '../assets/images/boston.png';

const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="left">
    <div class="links">
      <a href="mailto:garrett.michiels@gmail.com">Email</a>
      <span class="sep" aria-hidden="true">/</span>
      <a href="https://github.com/garrettmichiels" target="_blank" rel="noopener noreferrer">GitHub</a>
      <span class="sep" aria-hidden="true">/</span>
      <a href="https://www.linkedin.com/in/garrett-michiels/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
    </div>
    <p class="copy"><span id="footer-brand">garrettmichiels.com</span> · &copy;{currentYear}</p>
  </div>

  <div class="stamp">
    <!-- Perforated edge is baked into the PNG — don't recreate it in CSS -->
    <Image src={boston} alt="Boston" width={176} densities={[1, 2]} loading="lazy" draggable="false" />
    <span>boston, ma</span>
  </div>
</footer>

<style>
  .footer {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 30px;
    padding-top: 26px;
    border-top: 1px solid var(--card-border);
  }

  .left {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    font-size: 0.82rem;
  }

  .links a {
    color: var(--ink-link);
  }

  .links a:hover {
    color: var(--ink);
  }

  .sep {
    color: var(--slash);
  }

  .copy {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--ink-meta);
  }

  .stamp {
    flex: none;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 7px;
  }

  .stamp img {
    display: block;
    width: 176px;
    height: auto;
    transform: rotate(-2deg);
  }

  .stamp span {
    padding-right: 4px;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--ink-meta);
  }

  @media (max-width: 480px) {
    .footer {
      flex-wrap: wrap;
    }

    .stamp img {
      width: 132px;
    }
  }
</style>

<script>
  const el = document.getElementById('footer-brand');
  if (el) {
    const host = window.location.hostname;
    const known = ['garrettmichiels.com', 'garrettm.dev'];
    el.textContent = known.includes(host) ? host : 'garrettmichiels.com';
  }
</script>
