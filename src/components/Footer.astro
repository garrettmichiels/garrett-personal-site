---
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer-inner">
    <div class="footer-links">
      <a href="mailto:garrett.michiels@gmail.com" class="footer-link">Email</a>
      <span class="footer-sep">/</span>
      <a href="https://github.com/garrettmichiels" target="_blank" rel="noopener noreferrer" class="footer-link">GitHub</a>
      <span class="footer-sep">/</span>
      <a href="https://www.linkedin.com/in/garrett-michiels/" target="_blank" rel="noopener noreferrer" class="footer-link">LinkedIn</a>
    </div>
    <span class="footer-copy">
      <span class="footer-brand" id="footer-brand">garrettmichiels.com</span>
      &nbsp;·&nbsp; &copy;{currentYear}
    </span>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border-subtle);
    padding: var(--sp-8);
    background: var(--bg-raised);
  }

  .footer-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .footer-links {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
  }

  .footer-link {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-4);
    transition: color 0.2s ease;
  }

  .footer-link:hover {
    color: var(--accent);
  }

  .footer-sep {
    color: var(--text-6);
    font-size: 0.7rem;
  }

  .footer-brand {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    color: var(--ink);
    letter-spacing: -0.01em;
  }

  .brand-dot {
    color: var(--accent);
  }

  .footer-copy {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.06em;
    color: var(--text-5);
  }

  @media (max-width: 480px) {
    .footer-inner {
      flex-direction: column;
      gap: var(--sp-3);
      text-align: center;
    }
  }
</style>

<script>
  const el = document.getElementById('footer-brand');
  if (el) {
    const host = window.location.hostname;
    const known = ['garrettmichiels.com', 'garrettm.dev'];
    el.textContent = known.includes(host) ? host : 'garrettmichiels.com';
  }
</script>
