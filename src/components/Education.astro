---
import SectionLabel from './SectionLabel.astro';
import EntryRow from './EntryRow.astro';
import data from '../data/education.json';
import seal from '../assets/images/northeastern-ring.png';

const ACCENT = '#D51B2C';
---

<section id="education" class="education">
  <SectionLabel text="education" />

  <ul class="entry-list">
    <li>
      <EntryRow
        id="education-northeastern"
        name={data.institution}
        role={data.degreeShort}
        years={data.year}
        summary={data.college}
        logo={seal}
        accent={ACCENT}
      >
        <p class="degree">{data.degree}, {data.college}</p>
        <div class="meta-row">
          <span>{data.year}</span>
          <span class="dot"></span>
          <span>{data.location}</span>
        </div>
        {data.awards.map((award) => (
          <div class="award">
            <span class="award-label">award</span>
            <p>{award}</p>
          </div>
        ))}
      </EntryRow>
    </li>
  </ul>
</section>

<style>
  .education {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .degree {
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--ink-body);
  }

  .award {
    display: flex;
    flex-direction: column;
    gap: 7px;
    padding-top: 14px;
    border-top: 1px solid var(--rule-inner);
  }

  .award-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .award p {
    font-size: 0.95rem;
    line-height: 1.7;
  }
</style>
