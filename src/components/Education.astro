---
import { Image } from 'astro:assets';
import SectionLabel from './SectionLabel.astro';
import data from '../data/education.json';
import seal from '../assets/images/northeastern-ring.png';

const ACCENT = '#D51B2C';
---

<section id="education" class="education">
  <SectionLabel text="education" />

  <div class="card" style={`--edu-accent: ${ACCENT};`}>
    <div class="body">
      <div>
        <h2>{data.institution}</h2>
        <p class="college">{data.college}</p>
        <p class="degree">{data.degree}</p>
        <div class="meta-row">
          <span>{data.year}</span>
          <span class="dot"></span>
          <span>{data.location}</span>
        </div>
      </div>

      {data.awards.length > 0 && (
        <>
          <div class="rule"></div>
          {data.awards.map((award) => (
            <div class="award">
              <span class="award-label">award</span>
              <p>{award}</p>
            </div>
          ))}
        </>
      )}
    </div>

    <Image src={seal} alt="" width={176} class="seal" draggable="false" loading="lazy" />
  </div>
</section>

<style>
  .education {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .card {
    display: flex;
    align-items: flex-start;
    gap: 24px;
    background: var(--card);
    border: 1px solid var(--card-border);
    border-left: 3px solid var(--edu-accent);
    padding: 24px 26px;
  }

  .body {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  h2 {
    font-size: 1.6rem;
    line-height: 1.1;
  }

  .college {
    margin-top: 2px;
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 1.12rem;
    line-height: 1.3;
    color: var(--ink-lead);
  }

  .degree {
    margin-top: 6px;
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--ink-body);
  }

  .meta-row {
    margin-top: 8px;
  }

  .rule {
    height: 1px;
    background: var(--rule-inner);
  }

  .award {
    display: flex;
    flex-direction: column;
    gap: 7px;
  }

  .award-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .award p {
    font-size: 0.95rem;
    line-height: 1.7;
  }

  /* Multiply drops the seal's white ground so it prints onto the card stock */
  .seal {
    flex: none;
    width: 88px;
    height: auto;
    mix-blend-mode: multiply;
    opacity: 0.9;
  }

  @media (max-width: 640px) {
    .card {
      gap: 16px;
      padding: 20px 18px;
    }

    .seal {
      width: 56px;
    }
  }
</style>
