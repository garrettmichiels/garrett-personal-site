---
// Collapsed by default — kept, but tucked away for now.
const themes = [
  { id: 'paper', name: 'Paper', fill: '#F8F7F3', edge: '#C8BEA6' },
  { id: 'sage',  name: 'Sage',  fill: '#C2D9CC', edge: '#A6C2B4' },
  { id: 'warm',  name: 'Warm',  fill: '#FDF3E3', edge: '#E8D9BE' },
];
---

<div class="ts" id="theme-switcher">
  <div class="tray" id="ts-tray" role="group" aria-label="Color theme" hidden>
    {themes.map((t) => (
      <button
        class="swatch"
        data-theme-id={t.id}
        aria-label={`${t.name} theme`}
        aria-pressed="false"
        style={`--fill: ${t.fill}; --edge: ${t.edge};`}
      ></button>
    ))}
  </div>

  <button
    class="trigger"
    id="ts-toggle"
    title="Theme"
    aria-label="Theme"
    aria-expanded="false"
    aria-controls="ts-tray"
  >
    <span class="dot"></span>
  </button>
</div>

<style>
  .ts {
    position: fixed;
    right: 26px;
    bottom: 26px;
    z-index: 4;
    display: flex;
    align-items: center;
    gap: 9px;
  }

  .tray {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 6px 9px;
    border: 1px solid var(--card-border);
    background: var(--paper);
  }

  .swatch {
    display: block;
    width: 15px;
    height: 15px;
    border-radius: 50%;
    background: var(--fill);
    border: 1px solid var(--edge);
  }

  .swatch[aria-pressed="true"] {
    box-shadow: 0 0 0 2px var(--paper), 0 0 0 3px var(--accent);
  }

  .trigger {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    border: 1px solid var(--dot-border);
    background: var(--paper);
    transition: border-color 0.15s;
  }

  .trigger:hover {
    border-color: var(--accent);
  }

  .dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--dot-fill);
  }

  @media (max-width: 480px) {
    .ts {
      right: 16px;
      bottom: 16px;
    }
  }

  @media print {
    .ts {
      display: none;
    }
  }
</style>

<script>
  import { defineSound } from '@web-kits/audio';

  const themeClick = defineSound({
    source: { type: 'sine', frequency: { start: 880, end: 620 } },
    envelope: { attack: 0, decay: 0.055 },
    gain: 0.12,
  });

  const STORAGE_KEY = 'gm-theme';
  const DEFAULT     = 'paper';

  const html     = document.documentElement;
  const wrap     = document.getElementById('theme-switcher')!;
  const toggle   = document.getElementById('ts-toggle')!;
  const tray     = document.getElementById('ts-tray')!;
  const swatches = tray.querySelectorAll<HTMLButtonElement>('.swatch');

  function applyTheme(id: string) {
    if (id === DEFAULT) {
      html.removeAttribute('data-theme');
    } else {
      html.setAttribute('data-theme', id);
    }
    localStorage.setItem(STORAGE_KEY, id);
    swatches.forEach((btn) => {
      btn.setAttribute('aria-pressed', String(btn.dataset.themeId === id));
    });
  }

  function setOpen(open: boolean) {
    toggle.setAttribute('aria-expanded', String(open));
    tray.hidden = !open;
  }

  const isOpen = () => !tray.hidden;

  toggle.addEventListener('click', () => setOpen(!isOpen()));

  swatches.forEach((btn) => {
    btn.addEventListener('click', () => {
      themeClick();
      applyTheme(btn.dataset.themeId ?? DEFAULT);
    });
  });

  document.addEventListener('click', (e) => {
    if (isOpen() && !wrap.contains(e.target as Node)) setOpen(false);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isOpen()) {
      setOpen(false);
      toggle.focus();
    }
  });

  applyTheme(localStorage.getItem(STORAGE_KEY) ?? DEFAULT);
</script>
