---
interface Props {
  text: string;
  accent?: string;
}

const { text, accent } = Astro.props;

const bg     = accent ? `${accent}18` : 'rgba(0,0,0,0.05)';
const border = accent ? `${accent}35` : 'rgba(0,0,0,0.1)';
const color  = accent || 'var(--ink-3)';
---

<span class="tag" style={`background: ${bg}; border-color: ${border}; color: ${color};`}>
  {text}
</span>

<style>
  .tag {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: var(--radius);
    border: 1px solid;
    display: inline-block;
    white-space: nowrap;
    transition: opacity 0.15s ease;
  }

  .tag:hover {
    opacity: 0.8;
  }
</style>
