---
interface Props {
  text: string;
}

const { text } = Astro.props;
---

<span class="tag">{text}</span>

<style>
  .tag {
    display: inline-block;
    padding: 4px 9px;
    border: 1px solid var(--chip-border);
    background: var(--chip);
    color: var(--ink-chip);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
  }
</style>
