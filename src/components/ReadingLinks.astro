---
import SectionLabel from './SectionLabel.astro';
import Tag from './Tag.astro';
import items from '../data/reading-list.json';

const typeAccents: Record<string, string> = {
  article: 'var(--accent-slate)',
  blog: 'var(--accent-slate)',
  paper: 'var(--accent-rose)',
  book: 'var(--accent-gold)',
  tool: 'var(--accent-sage)',
};
---

<section class="section fade-in">
  <SectionLabel text="Reading & Links" accent="var(--accent-slate)" />
  <h2>What I'm reading</h2>
  <p class="reading-intro">
    Articles, papers, and books shaping how I think about software and AI.
  </p>

  <ul class="reading-list">
    {items.map((item, i) => (
      <li class="reading-item fade-in stagger-item">
        <span class="item-num">{String(i + 1).padStart(2, '0')}</span>
        <div class="item-content">
          <div class="item-header">
            <a href={item.url} target="_blank" rel="noopener noreferrer" class="item-title">
              {item.title}
            </a>
            <Tag text={item.type} accent={typeAccents[item.type] || undefined} />
          </div>
          <span class="item-author">{item.author}</span>
          {item.note && <p class="item-note">{item.note}</p>}
        </div>
      </li>
    ))}
  </ul>
</section>

<style>
  h2 {
    margin-top: 6px;
    margin-bottom: var(--sp-2);
  }

  .reading-intro {
    margin-bottom: var(--sp-8);
    color: var(--text-3);
  }

  .reading-list {
    display: flex;
    flex-direction: column;
  }

  .reading-item {
    display: flex;
    gap: var(--sp-4);
    padding: var(--sp-4) 0;
    border-bottom: 1px solid var(--border-subtle);
    opacity: 0;
  }

  .reading-item:first-child {
    border-top: 1px solid var(--border-subtle);
  }

  .item-num {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    color: var(--text-5);
    margin-top: 4px;
    flex-shrink: 0;
  }

  .item-content {
    flex: 1;
    min-width: 0;
  }

  .item-header {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    margin-bottom: 2px;
    flex-wrap: wrap;
  }

  .item-title {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-1);
    transition: color 0.2s ease;
  }

  .item-title:hover {
    color: var(--accent-slate);
  }

  .item-author {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.06em;
    color: var(--text-4);
    display: block;
    margin-bottom: 4px;
  }

  .item-note {
    font-size: 0.82rem;
    color: var(--text-3);
    line-height: 1.6;
    margin-top: 4px;
  }

  @media (max-width: 768px) {
    .item-num {
      display: none;
    }
  }
</style>
