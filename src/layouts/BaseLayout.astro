---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Garrett Michiels · Software Engineer',
  description = 'Software Engineer at Clarasight. Building high-impact systems at scale.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🤓</text></svg>" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400..600;1,6..72,400..600&family=Geist:wght@300..600&family=Geist+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>

    {/* Theme restore — disabled along with the theme switcher (see index.astro).
        Left on, a visitor with a saved theme would be stuck in it with no way back.
    <script is:inline>
      (function () {
        var t = localStorage.getItem('gm-theme');
        if (t && t !== 'paper') document.documentElement.setAttribute('data-theme', t);
      })();
    </script>
    */}
  </head>
  <body>
    <slot />

    <!-- Motion.dev scroll + entrance animations -->
    <script>
      import { animate, inView, stagger } from 'motion';

      function reveal(els: HTMLElement[], opts: { y?: number; duration?: number; delay?: number | ((i: number) => number) }) {
        els.forEach(el => { el.style.opacity = '0'; });
        animate(els, { opacity: [0, 1], y: [opts.y ?? 10, 0] }, {
          duration: opts.duration ?? 0.5,
          delay: opts.delay ?? 0,
          easing: [0.25, 0.46, 0.45, 0.94],
        }).then(() => {
          els.forEach(el => { el.style.opacity = '1'; el.style.transform = ''; });
        });
      }

      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        // Intro entrance: portrait, then the story
        const introEls = ['.intro .mount', '.intro .story']
          .map((sel) => document.querySelector<HTMLElement>(sel))
          .filter((el): el is HTMLElement => el !== null);

        if (introEls.length) reveal(introEls, { delay: stagger(0.12) });

        // Work rows: stagger in when the list enters view
        inView('.work .entry-list', () => {
          const items = [...document.querySelectorAll<HTMLElement>('.work .entry-list > li')];
          if (items.length) reveal(items, { y: 8, duration: 0.4, delay: stagger(0.08) });
        }, { amount: 0.1 });
      }

      /* Stat counter animation — disabled; see highlightNumbers in Work.astro.

      function animateCounter(el: HTMLElement) {
        const target   = parseInt(el.dataset.counter ?? '0', 10);
        const suffix   = el.dataset.suffix ?? '';
        const prefix   = el.dataset.prefix ?? '';
        const duration = 1800;
        const start    = performance.now();

        const easeOut = (t: number) => 1 - Math.pow(1 - t, 3);

        function tick(now: number) {
          const progress = Math.min((now - start) / duration, 1);
          el.textContent = prefix + Math.round(easeOut(progress) * target) + suffix;
          if (progress < 1) requestAnimationFrame(tick);
        }

        requestAnimationFrame(tick);
      }

      const counterObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            animateCounter(entry.target as HTMLElement);
            counterObserver.unobserve(entry.target);
          }
        });
      }, { threshold: 0.6 });

      document.querySelectorAll<HTMLElement>('[data-counter]').forEach((el) => {
        counterObserver.observe(el);
      });
      */
    </script>

  </body>
</html>

<style is:global>
  @import '../styles/global.css';
  @import '../styles/animations.css';
</style>
