---
/**
 * Geometric circuit-like lines for the Experience section margin.
 * Thin right-angle paths suggesting system architecture.
 */
---

<div class="circuit-lines" aria-hidden="true">
  <svg viewBox="0 0 120 500" xmlns="http://www.w3.org/2000/svg">
    <!-- Main vertical line -->
    <line x1="40" y1="20" x2="40" y2="480" stroke="#E8D5B7" stroke-width="0.5" opacity="0.06" />

    <!-- Branch 1 -->
    <polyline
      points="40,60 70,60 70,100 90,100"
      fill="none" stroke="#E8D5B7" stroke-width="0.5" opacity="0.1"
    />
    <circle cx="90" cy="100" r="2" fill="#E8D5B7" opacity="0.12" />

    <!-- Branch 2 -->
    <polyline
      points="40,160 60,160 60,130 80,130"
      fill="none" stroke="#B7D4E8" stroke-width="0.5" opacity="0.08"
    />
    <circle cx="80" cy="130" r="1.5" fill="#B7D4E8" opacity="0.1" />

    <!-- Branch 3 -->
    <polyline
      points="40,240 75,240 75,280 95,280"
      fill="none" stroke="#E8D5B7" stroke-width="0.5" opacity="0.1"
    />
    <rect x="93" y="277" width="6" height="6" rx="1" fill="none" stroke="#E8D5B7" stroke-width="0.5" opacity="0.12" />

    <!-- Branch 4 -->
    <polyline
      points="40,340 55,340 55,310"
      fill="none" stroke="#B7E8C8" stroke-width="0.5" opacity="0.08"
    />
    <circle cx="55" cy="310" r="2" fill="#B7E8C8" opacity="0.1" />

    <!-- Branch 5 -->
    <polyline
      points="40,420 65,420 65,450 85,450"
      fill="none" stroke="#E8D5B7" stroke-width="0.5" opacity="0.08"
    />
    <circle cx="85" cy="450" r="1.5" fill="#E8D5B7" opacity="0.1" />

    <!-- Node dots along main line -->
    <circle cx="40" cy="60" r="1.5" fill="#E8D5B7" opacity="0.15" />
    <circle cx="40" cy="160" r="1.5" fill="#B7D4E8" opacity="0.12" />
    <circle cx="40" cy="240" r="1.5" fill="#E8D5B7" opacity="0.15" />
    <circle cx="40" cy="340" r="1.5" fill="#B7E8C8" opacity="0.12" />
    <circle cx="40" cy="420" r="1.5" fill="#E8D5B7" opacity="0.12" />
  </svg>
</div>

<style>
  .circuit-lines {
    position: absolute;
    top: 80px;
    left: -140px;
    width: 120px;
    height: 500px;
    pointer-events: none;
    z-index: 0;
  }

  .circuit-lines svg {
    width: 100%;
    height: 100%;
  }

  @media (max-width: 900px) {
    .circuit-lines {
      display: none;
    }
  }
</style>
