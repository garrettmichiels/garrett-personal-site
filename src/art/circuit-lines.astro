---
// Animated circuit lines — signal sparks travel along each wire
---

<div class="circuit-lines" aria-hidden="true">
  <svg viewBox="0 0 120 500" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <!-- Soft glow for sparks -->
      <filter id="spark-glow" x="-80%" y="-80%" width="260%" height="260%">
        <feGaussianBlur in="SourceGraphic" stdDeviation="1.2" result="blur"/>
        <feMerge>
          <feMergeNode in="blur"/>
          <feMergeNode in="SourceGraphic"/>
        </feMerge>
      </filter>
    </defs>

    <!-- ── BASE WIRES (always visible, dim) ── -->
    <line x1="40" y1="20" x2="40" y2="480"
      stroke="#6F229A" stroke-width="0.5" opacity="0.1" />

    <polyline points="40,60 70,60 70,100 90,100"
      fill="none" stroke="#6F229A" stroke-width="0.5" opacity="0.13" />

    <polyline points="40,160 60,160 60,130 80,130"
      fill="none" stroke="#244277" stroke-width="0.5" opacity="0.12" />

    <polyline points="40,240 75,240 75,280 95,280"
      fill="none" stroke="#6F229A" stroke-width="0.5" opacity="0.13" />

    <polyline points="40,340 55,340 55,310"
      fill="none" stroke="#2C556B" stroke-width="0.5" opacity="0.12" />

    <polyline points="40,420 65,420 65,450 85,450"
      fill="none" stroke="#244277" stroke-width="0.5" opacity="0.12" />

    <!-- ── SIGNAL SPARKS (animated, with glow) ── -->
    <line x1="40" y1="20" x2="40" y2="480"
      stroke="#6F229A" stroke-width="1.5" stroke-linecap="round"
      pathLength="100" stroke-dasharray="5 95"
      class="spark spark-main"
      filter="url(#spark-glow)" />

    <polyline points="40,60 70,60 70,100 90,100"
      fill="none" stroke="#6F229A" stroke-width="2" stroke-linecap="round"
      pathLength="100" stroke-dasharray="16 84"
      class="spark spark-b1"
      filter="url(#spark-glow)" />

    <polyline points="40,160 60,160 60,130 80,130"
      fill="none" stroke="#244277" stroke-width="2" stroke-linecap="round"
      pathLength="100" stroke-dasharray="18 82"
      class="spark spark-b2"
      filter="url(#spark-glow)" />

    <polyline points="40,240 75,240 75,280 95,280"
      fill="none" stroke="#6F229A" stroke-width="2" stroke-linecap="round"
      pathLength="100" stroke-dasharray="16 84"
      class="spark spark-b3"
      filter="url(#spark-glow)" />

    <polyline points="40,340 55,340 55,310"
      fill="none" stroke="#2C556B" stroke-width="2" stroke-linecap="round"
      pathLength="100" stroke-dasharray="22 78"
      class="spark spark-b4"
      filter="url(#spark-glow)" />

    <polyline points="40,420 65,420 65,450 85,450"
      fill="none" stroke="#244277" stroke-width="2" stroke-linecap="round"
      pathLength="100" stroke-dasharray="18 82"
      class="spark spark-b5"
      filter="url(#spark-glow)" />

    <!-- ── ENDPOINT NODES (base dot + expanding ping ring) ── -->

    <!-- Branch 1 endpoint -->
    <circle cx="90" cy="100" r="2.5" fill="#6F229A" opacity="0.5" />
    <circle cx="90" cy="100" r="2.5" fill="none" stroke="#6F229A" stroke-width="1.5"
      class="ping ping-b1" />

    <!-- Branch 2 endpoint -->
    <circle cx="80" cy="130" r="2" fill="#244277" opacity="0.45" />
    <circle cx="80" cy="130" r="2" fill="none" stroke="#244277" stroke-width="1.5"
      class="ping ping-b2" />

    <!-- Branch 3 endpoint (square terminal) -->
    <rect x="92" y="276" width="7" height="7" rx="1.5"
      fill="none" stroke="#6F229A" stroke-width="0.8" opacity="0.4" />
    <rect x="92" y="276" width="7" height="7" rx="1.5"
      fill="none" stroke="#6F229A" stroke-width="1.5"
      class="ping-rect ping-b3" />

    <!-- Branch 4 endpoint -->
    <circle cx="55" cy="310" r="2.5" fill="#2C556B" opacity="0.45" />
    <circle cx="55" cy="310" r="2.5" fill="none" stroke="#2C556B" stroke-width="1.5"
      class="ping ping-b4" />

    <!-- Branch 5 endpoint -->
    <circle cx="85" cy="450" r="2" fill="#244277" opacity="0.4" />
    <circle cx="85" cy="450" r="2" fill="none" stroke="#244277" stroke-width="1.5"
      class="ping ping-b5" />

    <!-- ── JUNCTION DOTS on main line (pulse in rhythm) ── -->
    <circle cx="40" cy="60"  r="1.8" fill="#6F229A" class="junction" style="animation-delay:-0.6s" />
    <circle cx="40" cy="160" r="1.8" fill="#244277" class="junction" style="animation-delay:-1.6s" />
    <circle cx="40" cy="240" r="1.8" fill="#6F229A" class="junction" style="animation-delay:-0.4s" />
    <circle cx="40" cy="340" r="1.8" fill="#2C556B" class="junction" style="animation-delay:-3.2s" />
    <circle cx="40" cy="420" r="1.8" fill="#244277" class="junction" style="animation-delay:-4.0s" />
  </svg>
</div>

<style>
  /* ── Layout ── */
  .circuit-lines {
    position: absolute;
    top: 80px;
    left: -140px;
    width: 120px;
    height: 500px;
    pointer-events: none;
    z-index: 0;
  }

  .circuit-lines svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  @media (max-width: 900px) {
    .circuit-lines { display: none; }
  }

  /* ── Spark travel animation ── */
  @keyframes spark-flow {
    from { stroke-dashoffset: 100; }
    to   { stroke-dashoffset: 0;   }
  }

  .spark {
    opacity: 0.75;
    animation: spark-flow linear infinite;
  }

  /* Each branch has its own speed + offset so they feel organic */
  .spark-main { animation-duration: 4.5s; animation-delay:  0s;   }
  .spark-b1   { animation-duration: 2.2s; animation-delay: -0.6s; }
  .spark-b2   { animation-duration: 2.0s; animation-delay: -1.2s; }
  .spark-b3   { animation-duration: 2.6s; animation-delay: -0.4s; }
  .spark-b4   { animation-duration: 1.7s; animation-delay: -0.9s; }
  .spark-b5   { animation-duration: 2.3s; animation-delay: -1.5s; }

  /* ── Endpoint ping ring ── */
  @keyframes ping-out {
    0%   { transform: scale(1);   opacity: 0.7; }
    100% { transform: scale(3.5); opacity: 0;   }
  }

  .ping, .ping-rect {
    transform-box: fill-box;
    transform-origin: center;
    animation: ping-out ease-out infinite;
  }

  /* Match ping timing to the branch it belongs to */
  .ping-b1   { animation-duration: 2.2s; animation-delay: -0.4s; }
  .ping-b2   { animation-duration: 2.0s; animation-delay: -0.9s; }
  .ping-b3   { animation-duration: 2.6s; animation-delay: -1.8s; }
  .ping-b4   { animation-duration: 1.7s; animation-delay: -0.6s; }
  .ping-b5   { animation-duration: 2.3s; animation-delay: -1.2s; }

  /* ── Junction dot pulse ── */
  @keyframes junction-pulse {
    0%, 100% { opacity: 0.2; }
    50%       { opacity: 0.75; }
  }

  .junction {
    animation: junction-pulse 4.5s ease-in-out infinite;
  }
</style>
