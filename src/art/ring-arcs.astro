---
/**
 * Concentric ring/arc pattern for the Education section margin.
 * Evokes academic/scholarly feel with varying opacity and dash arrays.
 */
---

<div class="ring-arcs" aria-hidden="true">
  <svg viewBox="0 0 180 180" xmlns="http://www.w3.org/2000/svg">
    <!-- Outer ring - partial arc -->
    <circle
      cx="90" cy="90" r="80"
      fill="none" stroke="#B7E8C8" stroke-width="0.5" opacity="0.06"
      stroke-dasharray="60 30 20 40 80"
      transform="rotate(-30 90 90)"
    />

    <!-- Mid ring -->
    <circle
      cx="90" cy="90" r="60"
      fill="none" stroke="#B7E8C8" stroke-width="0.5" opacity="0.08"
      stroke-dasharray="40 50 30 60"
      transform="rotate(15 90 90)"
    />

    <!-- Inner ring -->
    <circle
      cx="90" cy="90" r="40"
      fill="none" stroke="#E8D5B7" stroke-width="0.5" opacity="0.07"
      stroke-dasharray="25 35 15 45"
      transform="rotate(-60 90 90)"
    />

    <!-- Core ring -->
    <circle
      cx="90" cy="90" r="20"
      fill="none" stroke="#E8D5B7" stroke-width="0.5" opacity="0.1"
      stroke-dasharray="12 20 8 25"
      transform="rotate(45 90 90)"
    />

    <!-- Accent dots at intersections -->
    <circle cx="90" cy="10" r="2" fill="#B7E8C8" opacity="0.1" />
    <circle cx="160" cy="60" r="1.5" fill="#B7E8C8" opacity="0.08" />
    <circle cx="30" cy="120" r="1.5" fill="#E8D5B7" opacity="0.08" />
    <circle cx="140" cy="150" r="2" fill="#B7E8C8" opacity="0.06" />
  </svg>
</div>

<style>
  .ring-arcs {
    position: absolute;
    top: -20px;
    right: -140px;
    width: 180px;
    height: 180px;
    pointer-events: none;
    z-index: 0;
  }

  .ring-arcs svg {
    width: 100%;
    height: 100%;
  }

  @media (max-width: 900px) {
    .ring-arcs {
      display: none;
    }
  }
</style>
