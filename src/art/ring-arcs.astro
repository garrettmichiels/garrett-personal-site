---
// Animated concentric ring pattern for the Education section.
// Mirrors the circuit-lines language: faint base + bright rotating signal sparks,
// pulsing dots, and expanding ping rings. Colored in Northeastern red.
---

<div class="ring-arcs" aria-hidden="true">
  <svg viewBox="0 0 180 180" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <filter id="ring-glow" x="-50%" y="-50%" width="200%" height="200%">
        <feGaussianBlur in="SourceGraphic" stdDeviation="1.1" result="blur" />
        <feMerge>
          <feMergeNode in="blur" />
          <feMergeNode in="SourceGraphic" />
        </feMerge>
      </filter>
    </defs>

    <!-- ── BASE RINGS (always visible, dim) ── -->
    <circle cx="90" cy="90" r="80"
      fill="none" stroke="#D51B2C" stroke-width="0.5" opacity="0.1"
      stroke-dasharray="60 30 20 40 80" />

    <circle cx="90" cy="90" r="60"
      fill="none" stroke="#D51B2C" stroke-width="0.5" opacity="0.13"
      stroke-dasharray="40 50 30 60" />

    <circle cx="90" cy="90" r="40"
      fill="none" stroke="#D51B2C" stroke-width="0.5" opacity="0.14"
      stroke-dasharray="25 35 15 45" />

    <circle cx="90" cy="90" r="20"
      fill="none" stroke="#D51B2C" stroke-width="0.5" opacity="0.16"
      stroke-dasharray="12 20 8 25" />

    <!-- ── SIGNAL SPARKS (rotating arcs, brighter, glowing) ── -->
    <g class="spin spin-outer">
      <circle cx="90" cy="90" r="80"
        fill="none" stroke="#D51B2C" stroke-width="1.2" stroke-linecap="round"
        stroke-dasharray="14 489" opacity="0.7"
        filter="url(#ring-glow)" />
    </g>

    <g class="spin spin-mid">
      <circle cx="90" cy="90" r="60"
        fill="none" stroke="#D51B2C" stroke-width="1.4" stroke-linecap="round"
        stroke-dasharray="18 359" opacity="0.75"
        filter="url(#ring-glow)" />
    </g>

    <g class="spin spin-inner">
      <circle cx="90" cy="90" r="40"
        fill="none" stroke="#D51B2C" stroke-width="1.4" stroke-linecap="round"
        stroke-dasharray="14 237" opacity="0.7"
        filter="url(#ring-glow)" />
    </g>

    <g class="spin spin-core">
      <circle cx="90" cy="90" r="20"
        fill="none" stroke="#D51B2C" stroke-width="1.5" stroke-linecap="round"
        stroke-dasharray="10 116" opacity="0.75"
        filter="url(#ring-glow)" />
    </g>

    <!-- ── CENTER NODE (pulses) ── -->
    <circle cx="90" cy="90" r="2" fill="#D51B2C" opacity="0.55"
      class="junction" style="animation-delay: 0s" />

    <!-- ── PING NODES at orbital points ── -->
    <!-- Outer orbit -->
    <circle cx="90" cy="10" r="2" fill="#D51B2C" opacity="0.4" />
    <circle cx="90" cy="10" r="2" fill="none" stroke="#D51B2C" stroke-width="1.2"
      class="ping ping-n" />

    <!-- Mid orbit -->
    <circle cx="150" cy="90" r="1.8" fill="#D51B2C" opacity="0.35" />
    <circle cx="150" cy="90" r="1.8" fill="none" stroke="#D51B2C" stroke-width="1.2"
      class="ping ping-e" />

    <!-- Inner orbit -->
    <circle cx="50" cy="90" r="1.6" fill="#D51B2C" opacity="0.35" />
    <circle cx="50" cy="90" r="1.6" fill="none" stroke="#D51B2C" stroke-width="1.2"
      class="ping ping-w" />

    <!-- Off-axis junction dots -->
    <circle cx="160" cy="60" r="1.4" fill="#D51B2C" class="junction" style="animation-delay: -1.2s" />
    <circle cx="30"  cy="120" r="1.4" fill="#D51B2C" class="junction" style="animation-delay: -2.6s" />
    <circle cx="140" cy="150" r="1.6" fill="#D51B2C" class="junction" style="animation-delay: -3.8s" />
  </svg>
</div>

<style>
  .ring-arcs {
    position: absolute;
    top: -20px;
    right: -140px;
    width: 180px;
    height: 180px;
    pointer-events: none;
    z-index: 0;
  }

  .ring-arcs svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  @media (max-width: 900px) {
    .ring-arcs {
      display: none;
    }
  }

  /* ── Rotating spark arcs ── */
  @keyframes spin-cw {
    from { transform: rotate(0deg);   }
    to   { transform: rotate(360deg); }
  }

  @keyframes spin-ccw {
    from { transform: rotate(0deg);    }
    to   { transform: rotate(-360deg); }
  }

  .spin {
    transform-origin: 90px 90px;
  }

  /* Each ring spins at its own tempo — alternating direction adds depth */
  .spin-outer { animation: spin-cw  9s linear infinite; }
  .spin-mid   { animation: spin-ccw 6s linear infinite; }
  .spin-inner { animation: spin-cw  4.5s linear infinite; }
  .spin-core  { animation: spin-ccw 3s linear infinite; }

  /* ── Ping rings (echo outward from anchor nodes) ── */
  @keyframes ping-out {
    0%   { transform: scale(1);   opacity: 0.7; }
    100% { transform: scale(3.5); opacity: 0;   }
  }

  .ping {
    transform-box: fill-box;
    transform-origin: center;
    animation: ping-out ease-out infinite;
  }

  .ping-n { animation-duration: 2.4s; animation-delay: -0.4s; }
  .ping-e { animation-duration: 2.0s; animation-delay: -1.1s; }
  .ping-w { animation-duration: 2.6s; animation-delay: -1.7s; }

  /* ── Junction dot pulse ── */
  @keyframes junction-pulse {
    0%, 100% { opacity: 0.2; }
    50%      { opacity: 0.75; }
  }

  .junction {
    animation: junction-pulse 4s ease-in-out infinite;
  }
</style>
