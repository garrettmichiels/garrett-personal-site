---
// Organic blob shapes for the Hero section — green/amber tones on paper bg
---

<div class="margin-blobs" aria-hidden="true">
  <svg viewBox="0 0 200 400" xmlns="http://www.w3.org/2000/svg">
    <!-- Large green blob -->
    <path
      d="M120,40 C160,20 190,60 180,110 C170,160 200,190 170,230 C140,270 100,240 90,200 C80,160 60,140 80,100 C100,60 80,60 120,40Z"
      fill="#6F229A"
      opacity="0.06"
    />
    <!-- Medium amber blob -->
    <path
      d="M60,120 C100,90 150,110 140,160 C130,210 160,250 120,270 C80,290 40,260 50,220 C60,180 20,150 60,120Z"
      fill="#244277"
      opacity="0.05"
    />
    <!-- Accent dot cluster -->
    <circle cx="140" cy="80" r="3" fill="#6F229A" opacity="0.2" />
    <circle cx="155" cy="95" r="2" fill="#6F229A" opacity="0.13" />
    <circle cx="130" cy="100" r="1.5" fill="#244277" opacity="0.15" />
    <circle cx="90" cy="300" r="2.5" fill="#6F229A" opacity="0.15" />
    <circle cx="105" cy="315" r="1.5" fill="#244277" opacity="0.1" />
  </svg>
</div>

<style>
  .margin-blobs {
    position: absolute;
    top: -40px;
    right: -120px;
    width: 200px;
    height: 400px;
    pointer-events: none;
    z-index: 0;
  }

  .margin-blobs svg {
    width: 100%;
    height: 100%;
  }

  @media (max-width: 900px) {
    .margin-blobs {
      display: none;
    }
  }
</style>
